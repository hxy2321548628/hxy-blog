# 本文件只提供可提交的示例值；复制为 .env 后再填写本地密码。
# Docker Compose 的 ${VAR:?message} 会拒绝缺失变量，因此不要删除必填项。

# Go API 在宿主机开发时的监听地址；冒号开头表示监听所有本机网络接口。
HTTP_ADDR=:8080

# MySQL 应用连接配置。宿主机运行 Go 时使用 127.0.0.1；容器内由 Compose
# 覆盖为服务发现名称 mysql。示例密码不得用于生产环境。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hxy_blog
MYSQL_USER=hxy_blog
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# 管理员会话配置。示例 JWT 密钥仅用于本机开发，生产必须替换为至少 32 字节的
# 密码学随机值；轮换期间可同时配置上一把 key，平时保持为空。
AUTH_JWT_CURRENT_KEY_ID=local-development
AUTH_JWT_CURRENT_KEY=local-development-only-key-change-me-1234567890
AUTH_JWT_PREVIOUS_KEY_ID=
AUTH_JWT_PREVIOUS_KEY=
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
AUTH_SECURE_COOKIE=false

# Docker Compose 端口只绑定宿主机回环地址，端口号可在本机冲突时调整。
MYSQL_BIND_PORT=3306
WEB_BIND_PORT=8080

# 本地镜像名；生产环境由 CD 注入 GHCR Digest。APP_* 会写入 OCI 标签，
# 用于从容器追溯源码版本，不包含业务密钥。
API_IMAGE=hxy-blog-api:local
WEB_IMAGE=hxy-blog-web:local
MYSQL_IMAGE=mysql:8.0@sha256:7dcddc01f13bab2f15cde676d44d01f61fc9f99fe7785e86196dfc07d358ae2b
APP_VERSION=dev
APP_REVISION=local

# Docker 构建 Go 模块时的代理；默认与 Go 官方一致，网络不可达时可在本地 .env 覆盖。
GO_MODULE_PROXY=https://proxy.golang.org,direct
